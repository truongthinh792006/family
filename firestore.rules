rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['photoId', 'userId', 'userName', 'userPhoto', 'text', 'createdAt'])
        && data.keys().size() == 6
        && data.photoId is string && data.photoId.size() <= 200
        && data.userId is string && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.userName is string && data.userName.size() <= 100
        && data.userPhoto is string && data.userPhoto.size() <= 1000
        && data.text is string && data.text.size() > 0 && data.text.size() <= 1000
        && data.createdAt == request.time;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(commentId) && isValidComment(incoming());
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read, write: if true;
    }

    match /customAlbums/{albumId} {
      allow read, write: if true;
    }

    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
